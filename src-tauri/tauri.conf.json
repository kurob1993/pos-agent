{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS Agent",
  "version": "0.8.0",
  "identifier": "id.co.krakatau-it.pos-agent",
  "build": { "frontendDist": "../ui" },
  "app": { "windows": [], "withGlobalTauri": true, "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPDATA/ad-media/**"] } } },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": { "deb": { "recommends": ["mpv"] } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
